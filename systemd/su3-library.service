[Unit]
Description=Install the local SU(3) Raman reference library
ConditionPathExists=/var/lib/su3-raman/library.tar.gz
After=local-fs.target
StartLimitIntervalSec=0

[Service]
Type=exec
User=luxos
Environment=PYTHONPATH=/opt/su3-raman/runtime OPENBLAS_NUM_THREADS=1
ExecStart=/usr/bin/python3 /opt/su3-raman/load-library.py
Restart=on-failure
RestartSec=30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/su3-raman

[Install]
WantedBy=multi-user.target
