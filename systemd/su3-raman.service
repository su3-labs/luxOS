[Unit]
Description=SU(3) Raman local site and API
After=network.target

[Service]
User=luxos
WorkingDirectory=/opt/su3-raman
Environment=PYTHONPATH=/opt/su3-raman/runtime OPENBLAS_NUM_THREADS=1 PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m uvicorn api:app --host 0.0.0.0 --port 8000 --limit-concurrency 12 --no-access-log
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes

[Install]
WantedBy=multi-user.target
