[Unit]
Description=SU(3) Raman local site and API
After=network.target

[Service]
User=luxos
WorkingDirectory=/opt/su3-raman
ExecStart=/opt/su3-raman/luxos serve
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes

[Install]
WantedBy=multi-user.target
